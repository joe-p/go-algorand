;; Create a pool token, retrieve its ID, and read its just-created holding.
;; No arguments approves; one rejects; two traps; three exhausts fuel, all
;; after submission so the real ledger tests can verify atomic rollback.
(module
  (import "env" "itxn_begin" (func $begin))
  (import "env" "itxn_field_uint" (func $uint (param i32 i64)))
  (import "env" "itxn_field_bytes" (func $bytes (param i32 i32 i32)))
  (import "env" "itxn_submit" (func $submit))
  (import "env" "itxn_created_asset_id" (func $id (result i64)))
  (import "env" "global_bytes" (func $address (param i32 i32 i32) (result i32)))
  (import "env" "asset_balance" (func $balance (param i32 i64 i32) (result i32)))
  (import "env" "txn_uint" (func $txn (param i32) (result i64)))
  (memory (export "memory") 1)
  (data (i32.const 32) "DPT-A-B")
  (data (i32.const 48) "dpt")
  (func (export "program") (result i32) (local $asset i64)
    (call $begin)
    (call $uint (i32.const 16) (i64.const 3))
    (call $uint (i32.const 1) (i64.const 0))
    (call $uint (i32.const 34) (i64.const 10000000000))
    (call $uint (i32.const 35) (i64.const 3))
    (call $bytes (i32.const 38) (i32.const 32) (i32.const 7))
    (call $bytes (i32.const 37) (i32.const 48) (i32.const 3))
    (drop (call $address (i32.const 10) (i32.const 0) (i32.const 32)))
    (call $bytes (i32.const 41) (i32.const 0) (i32.const 32))
    (call $bytes (i32.const 42) (i32.const 0) (i32.const 32))
    (call $submit)
    (local.set $asset (call $id))
    (if (i32.eqz (call $balance (i32.const 0) (local.get $asset) (i32.const 64))) (then (unreachable)))
    (if (i64.ne (i64.load (i32.const 64)) (i64.const 10000000000)) (then (unreachable)))
    (if (i64.eq (call $txn (i32.const 27)) (i64.const 2)) (then (unreachable)))
    (if (i64.eq (call $txn (i32.const 27)) (i64.const 3)) (then (loop $forever (br $forever))))
    (i64.eqz (call $txn (i32.const 27)))))
