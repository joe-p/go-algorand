;; Opt into two foreign assets atomically, exercising next and group submission.
(module
  (import "env" "itxn_begin" (func $begin))
  (import "env" "itxn_next" (func $next))
  (import "env" "itxn_field_uint" (func $uint (param i32 i64)))
  (import "env" "itxn_field_bytes" (func $bytes (param i32 i32 i32)))
  (import "env" "itxn_submit" (func $submit))
  (import "env" "global_bytes" (func $address (param i32 i32 i32) (result i32)))
  (import "env" "txna_uint" (func $asset (param i32 i32) (result i64)))
  (memory (export "memory") 1)
  (func $fields (param $index i32)
    (call $uint (i32.const 16) (i64.const 4))
    (call $uint (i32.const 1) (i64.const 0))
    (call $uint (i32.const 17) (call $asset (i32.const 48) (local.get $index)))
    (call $uint (i32.const 18) (i64.const 0))
    (call $bytes (i32.const 20) (i32.const 0) (i32.const 32)))
  (func (export "program") (result i32)
    (call $begin)
    (drop (call $address (i32.const 10) (i32.const 0) (i32.const 32)))
    (call $fields (i32.const 0))
    (call $next)
    (call $fields (i32.const 1))
    (call $submit)
    (i32.const 1)))
