+/// Verifies through the host's `ed25519verify_bare` opcode (the WASM LogicSig
+/// ABI). This fork replaces the pure-Rust verification so an on-chain check
+/// matches the AVM's opcode and costs its fuel instead of guest curve
+/// arithmetic.
+///
+/// On native targets [`VerifyingKey::verify`] and [`VerifyingKey::verify_strict`]
+/// keep upstream ed25519-dalek behavior, so the crate still behaves normally
+/// when built or tested off-chain.
+#[cfg(target_arch = "wasm32")]
+impl VerifyingKey {
+    fn host_verify(
+        &self,
+        message: &[u8],
+        signature: &ed25519::Signature,
+    ) -> Result<(), SignatureError> {
+        if avm_sys::ed25519_verify_bare(message, &signature.to_bytes(), &self.to_bytes()) {
+            Ok(())
+        } else {
+            Err(InternalError::Verify.into())
+        }
+    }
+}
+
